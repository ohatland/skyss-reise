# Copy to .env.local (ignored by git) and fill in. Never commit values.

# PostHog project key (starts with phc_). Without it the app logs to the console only.
EXPO_PUBLIC_POSTHOG_KEY=

# PostHog host. Leave empty for the EU region (https://eu.i.posthog.com).
EXPO_PUBLIC_POSTHOG_HOST=

# Optional. Entur asks for "company-application" in the ET-Client-Name header.
# EXPO_PUBLIC_ENTUR_CLIENT_NAME=
